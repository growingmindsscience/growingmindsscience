# Growing Minds Science — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.

# ── Required: Waitlist & Contact Forms ─────────────────────────────────────────
# Web3Forms access key — get one free at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# ── Required: Authentication ────────────────────────────────────────────────────
# The single member account credentials.
# Generate a PBKDF2-SHA256 hash (210k iterations) for the password.
GMS_LOGIN_EMAIL=
GMS_LOGIN_PASSWORD_HASH=
GMS_LOGIN_PASSWORD_SALT=
GMS_LOGIN_NAME=

# A strong random string used to sign session tokens (32+ chars recommended).
GMS_SESSION_SECRET=

# ── Required: Growing Minds AI ──────────────────────────────────────────────────
# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Access code given to enrolled class members to unlock the AI tutor.
GMS_AI_ACCESS_CODE=

# ── Optional: Growing Minds AI ──────────────────────────────────────────────────
# OpenAI model override (default: gpt-5.5)
OPENAI_MODEL=

# OpenAI vector store ID for grounding AI answers in course content.
OPENAI_VECTOR_STORE_ID=

# ── Optional: Email List (ConvertKit / Kit) ─────────────────────────────────────
# Subscribe waitlist signups to a Kit form automatically.
KIT_API_KEY=
KIT_FORM_ID=

# ── Optional: Google OAuth ──────────────────────────────────────────────────────
GMS_GOOGLE_CLIENT_ID=
GMS_GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed Gmail addresses, OR an allowed domain.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
