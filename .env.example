# Growing Minds Science — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.

# ── Required: Waitlist & Contact Forms ─────────────────────────────────────────
# Web3Forms access key — get one free at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# ── Required: Growing Minds AI ─────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Access code given to enrolled class members to unlock the unlimited AI tier.
# Use a long random value (for example `openssl rand -hex 8`, 16 characters),
# not a word: the limits on wrong guesses are soft (per isolate). Rotate it if
# it leaks.
GMS_AI_ACCESS_CODE=

# Optional: Anthropic model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ── Required: Member Authentication ────────────────────────────────────────────
# The single member account credentials.
# Generate a PBKDF2-SHA256 hash (210k iterations) with scripts/hash-password.mjs.
GMS_LOGIN_EMAIL=
GMS_LOGIN_NAME=
GMS_LOGIN_PASSWORD_HASH=
GMS_LOGIN_PASSWORD_SALT=

# A strong random string used to sign session tokens (32+ chars recommended).
GMS_SESSION_SECRET=

# ── Required: Stripe (Growing Minds AI Pro subscription) ───────────────────────
STRIPE_SECRET_KEY=
# AI Pro price id read by api/create-checkout-session.js. Optional in production
# (it falls back to the live price id in that file); set it when using test keys.
AI_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Checkout redirect URLs are built from the request's own origin; there is no
# SITE_URL setting.

# ── Required: Supabase (subscriber records) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Email List (ConvertKit / Kit) ────────────────────────────────────
# Subscribe waitlist signups to a Kit form automatically.
KIT_API_KEY=
KIT_FORM_ID=
# Form used for paid subscribers (optional).
KIT_PAID_FORM_ID=

# ── Optional: Google OAuth (member sign-in) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in with Google: a comma-separated list of addresses, and/or one
# allowed domain (when both are set, an account must match both). At least one
# is required: with neither set, Google sign-in stays off.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
