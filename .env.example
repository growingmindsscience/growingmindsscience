# Growing Minds Science — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.

# ── Required: Waitlist & Contact Forms ─────────────────────────────────────────
# Web3Forms access key — get one free at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# ── Required: Growing Minds AI ─────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Access code given to enrolled class members to unlock the unlimited AI tier.
GMS_AI_ACCESS_CODE=

# Optional: Anthropic model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# ── Required: Member Authentication ────────────────────────────────────────────
# The single member account credentials.
# Generate a PBKDF2-SHA256 hash (210k iterations) with scripts/hash-password.mjs.
GMS_LOGIN_EMAIL=
GMS_LOGIN_NAME=
GMS_LOGIN_PASSWORD_HASH=
GMS_LOGIN_PASSWORD_SALT=

# A strong random string used to sign session tokens (32+ chars recommended).
GMS_SESSION_SECRET=

# ── Required: Stripe (Growing Minds AI Pro subscription) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public base URL used for Stripe redirect URLs, e.g. https://growingmindsscience.com
SITE_URL=

# ── Required: Supabase (subscriber records) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Email List (ConvertKit / Kit) ────────────────────────────────────
# Subscribe waitlist signups to a Kit form automatically.
KIT_API_KEY=
KIT_FORM_ID=
# Form used for paid subscribers (optional).
KIT_PAID_FORM_ID=

# ── Optional: Google OAuth (member sign-in) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed Gmail addresses, OR an allowed domain.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
