# Growing Minds Science — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.

# ── Required: Waitlist & Contact Forms ─────────────────────────────────────────
# Web3Forms access key — get one free at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# ── Required: Growing Minds AI ─────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Access code given to enrolled class members to unlock the class tier
# (50 questions a day). Use a long random value (for example
# `openssl rand -hex 8`, 16 characters), not a word: the limits on wrong
# guesses are soft (per isolate). Rotate it if it leaks.
GMS_AI_ACCESS_CODE=

# Optional: Anthropic model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Optional but recommended: count the daily AI allowances (5 free, 50 for class
# families) in one shared table instead of per isolate. The nsc Supabase
# project's URL and service-role key (migration 0021_ai_free_usage.sql);
# GMS_SESSION_SECRET must also be set.
AI_USAGE_SUPABASE_URL=
AI_USAGE_SUPABASE_SERVICE_ROLE_KEY=

# ── Required: Member Authentication ────────────────────────────────────────────
# The single member account credentials.
# Generate a PBKDF2-SHA256 hash (210k iterations) with scripts/hash-password.mjs.
GMS_LOGIN_EMAIL=
GMS_LOGIN_NAME=
GMS_LOGIN_PASSWORD_HASH=
GMS_LOGIN_PASSWORD_SALT=

# A strong random string used to sign session tokens (32+ chars recommended).
GMS_SESSION_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────────
# AI Pro is no longer sold. STRIPE_SECRET_KEY is still read by
# api/verify-subscription.js, so existing AI Pro subscribers can unlock until
# their subscriptions end; remove it together with that endpoint afterwards.
STRIPE_SECRET_KEY=
# Verifies purchase events sent to api/stripe-webhook.js.
STRIPE_WEBHOOK_SECRET=

# ── Required: Supabase (purchase records) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: Email List (ConvertKit / Kit) ────────────────────────────────────
# Subscribe waitlist signups to a Kit form automatically.
KIT_API_KEY=
KIT_FORM_ID=
# Form used for paying customers (optional).
KIT_PAID_FORM_ID=

# ── Optional: Google OAuth (member sign-in) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in with Google: a comma-separated list of addresses, and/or one
# allowed domain (when both are set, an account must match both). At least one
# is required: with neither set, Google sign-in stays off.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
