{
  "redirects": [
    { "source": "/milestones.html", "destination": "/milestones", "permanent": true },
    { "source": "/pricing.html",    "destination": "/pricing",    "permanent": true }
  ],
  "rewrites": [
    { "source": "/pricing",        "destination": "/pricing.html" },
    { "source": "/classes",        "destination": "/classes/index.html" },
    { "source": "/about",          "destination": "/about/index.html" },
    { "source": "/tools",          "destination": "/tools/index.html" },
    { "source": "/articles",       "destination": "/articles/index.html" },
    { "source": "/faq",            "destination": "/faq/index.html" },
    { "source": "/login",          "destination": "/login.html" },
    { "source": "/account",        "destination": "/account.html" },
    { "source": "/milestones",     "destination": "/milestones.html" },
    { "source": "/thank-you",      "destination": "/thank-you.html" },
    { "source": "/classes/toddlerhood",                     "destination": "/classes/toddlerhood.html" },
    { "source": "/tools/limits-without-escalation",         "destination": "/tools/limits-without-escalation.html" },
    { "source": "/tools/whats-underneath-the-meltdown",     "destination": "/tools/whats-underneath-the-meltdown.html" },
    { "source": "/tools/repair-after-the-hard-moment",      "destination": "/tools/repair-after-the-hard-moment.html" },
    { "source": "/tools/whats-typical-by-stage",            "destination": "/tools/whats-typical-by-stage.html" },
    { "source": "/tools/routines-transitions-night-waking", "destination": "/tools/routines-transitions-night-waking.html" },
    { "source": "/tools/growing-minds-ai",                  "destination": "/tools/growing-minds-ai.html" },
    { "source": "/articles/serve-and-return",               "destination": "/articles/serve-and-return.html" },
    { "source": "/articles/screen-time",                    "destination": "/articles/screen-time.html" },
    { "source": "/articles/toddler-no",                     "destination": "/articles/toddler-no.html" },
    { "source": "/articles/self-regulation",                "destination": "/articles/self-regulation.html" },
    { "source": "/api/checkout",                           "destination": "/api/checkout.js" },
    { "source": "/api/stripe-webhook",                     "destination": "/api/stripe-webhook.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; upgrade-insecure-requests" }
      ]
    }
  ]
}
