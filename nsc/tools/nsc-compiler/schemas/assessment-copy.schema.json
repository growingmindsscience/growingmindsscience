{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nsc/assessment-copy.schema.json",
  "title": "NSC assessment copy artifact (assessment.copy.vN.json) — spec §5.1",
  "description": "Every parent-facing string in the assessment flow, keyed by titration machine state. Placeholders: {name} {N} {objects}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "version", "states"],
  "properties": {
    "artifact": { "const": "assessment.copy" },
    "version": { "type": "string", "pattern": "^v[0-9]+(-gold)?$" },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(setup:checklist|setup:rules|praise|pause|resume|bonus|prescreen:intro|prescreen:q[1-5](:opts)?|trial:[1-6]:[1-3]|check:[1-6]|end:(L0|L1|L2|L3|L4|L4near|CP):(high|medium|low))$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lines"],
        "properties": {
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 2, "maxLength": 300 }
          }
        }
      }
    }
  }
}
