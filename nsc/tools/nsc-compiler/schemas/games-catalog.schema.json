{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nsc/games-catalog.schema.json",
  "title": "NSC games catalog artifact (games.catalog.vN.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact", "version", "games"],
  "properties": {
    "artifact": { "const": "games.catalog" },
    "version": { "type": "string", "pattern": "^v[0-9]+(-gold)?$" },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "game.schema.json" }
    }
  }
}
