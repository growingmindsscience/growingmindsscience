{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nsc/game.schema.json",
  "title": "NSC game catalog entry (games.catalog.v1) — spec §4.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "levels",
    "age_bands",
    "goal",
    "materials",
    "duration_min",
    "frequency_rx",
    "script",
    "level_up",
    "level_down",
    "bilingual_note",
    "evidence",
    "printable_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^game\\.(l0|l1|l2|l3|l4|cp|cpx)\\.[a-z0-9-]+$"
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 60 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["L0", "L1", "L2", "L3", "L4", "CP", "CPX"] }
    },
    "age_bands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["24-30m", "30-36m", "36-42m", "42-48m", "48-60m"] }
    },
    "goal": { "type": "string", "minLength": 10, "maxLength": 160 },
    "materials": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 80 }
    },
    "duration_min": { "type": "integer", "minimum": 2, "maximum": 20 },
    "frequency_rx": { "type": "string", "maxLength": 40 },
    "script": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 5, "maxLength": 220 }
    },
    "level_up": { "type": "string", "minLength": 10, "maxLength": 220 },
    "level_down": { "type": "string", "minLength": 10, "maxLength": 220 },
    "bilingual_note": { "type": "string", "minLength": 10, "maxLength": 220 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag_ids", "strength", "consensus"],
      "properties": {
        "tag_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ev\\.[a-z]+\\.[a-z0-9]+$" }
        },
        "strength": {
          "enum": [
            "correlational-strong",
            "rct",
            "rct-replicated",
            "theory-derived"
          ]
        },
        "consensus": { "enum": ["high", "moderate", "emerging"] }
      }
    },
    "printable_id": { "type": ["string", "null"] }
  }
}
