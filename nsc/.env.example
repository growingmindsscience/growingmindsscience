# Server-only secrets (set via `vercel env add`, never committed):
# SUPABASE_SERVICE_ROLE_KEY=   # Supabase dashboard → project settings → API
# STRIPE_SECRET_KEY=           # Stripe dashboard → API keys (live sk_live_…)
# STRIPE_WEBHOOK_SECRET=       # from the webhook endpoint you create (whsec_…)
# TODDLER_CLASS_PRICE_ID=      # $49 one-time Stripe Price for the Toddler class
# TODDLER_CLASS_SALES_ENABLED=0 # set to 1 only after 29 lessons, migration, and QA
# INFANT_CLASS_PRICE_ID=       # $49 one-time Stripe Price for the infant class
# INFANT_CLASS_TEST_USER_ID=   # optional: one Supabase user id that may buy while sales are still closed
# INFANT_CLASS_SALES_ENABLED=0 # set to 1 only after all 16 lessons are published and checkout QA passes
# PRESCHOOL_CLASS_PRICE_ID=    # $49 one-time Stripe Price for the preschool class (unset until launch)
# PRESCHOOL_CLASS_SALES_ENABLED=0 # set to 1 only after all 15 lessons are published and checkout QA passes
# MUX_TOKEN_ID=               # Mux API token ID (server only)
# MUX_TOKEN_SECRET=           # Mux API token secret (server only)
# MUX_SIGNING_KEY_ID=          # Mux signed-playback key ID
# MUX_SIGNING_PRIVATE_KEY=     # Base64-encoded PEM private key from Mux
# MUX_PLAYBACK_RESTRICTION_ID= # Referrer restriction allowing growingmindsscience.com
# CLASS_ADMIN_USER_IDS=        # comma-separated Supabase auth.users UUIDs allowed to upload/publish lessons
