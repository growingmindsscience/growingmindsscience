.vercel

.claude/

# Impeccable local cache (design docs + config are tracked)
.impeccable/hook.cache.json

# Local environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Node artifacts — only used locally for the tools smoke test (playwright-core).
# Kept out of the repo so this static site has no package.json for Vercel to build.
# NOTE: anchored to the repo root on purpose — the nsc/ Next.js app NEEDS its
# manifest tracked (the previous unanchored "package.json" rule silently
# swallowed nsc/package.json and left the app unbuildable from a fresh clone).
node_modules/
/package.json
/package-lock.json

# Programmatic developmental library — GENERATED output. Source of truth is
# library/entries/*.json; regenerate with scripts/build-library.mjs. Drafts stay
# uncommitted (never deployed) until an entry is flipped to status:"approved" and
# published — that is the human sign-off. See library/README.md.
/answers/

# Design-tool working files (screenshots and inspector output), never shipped
.impeccable/review/
.impeccable/mocks/
.taste-skill/
.playwright-cli/

# Ship-gate working files (scripts/fg-gate.mjs): tools, screenshots, raw reports
.fg-gate/
scripts/brand-mark/fonts/
scripts/brand-mark/out/

# Instagram pipeline: renders and the local review page are generated, never committed
marketing/instagram/posts/*/out/
marketing/instagram/review.html
marketing/instagram/templates/carousel/.stage-*.html
